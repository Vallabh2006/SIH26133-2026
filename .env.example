FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=generate-with-python-c-import-secrets-print(secrets.token_hex(32))

DB_TYPE=postgres
PG_HOST=db.xxxxx.supabase.co
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-db-password
PG_DB=postgres
PG_SSLMODE=require

COMPOSE_PG_HOST=db
COMPOSE_PG_DB=anvaya_vistara
COMPOSE_PG_SSLMODE=disable

SESSION_TYPE=redis
SESSION_REDIS=redis://localhost:6379/0
COMPOSE_SESSION_REDIS=redis://redis:6379/0

SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
MAIL_USE_TLS=True
SMTP_USE_SSL=false

MAIL_USERNAME=your-mailjet-api-key
MAIL_PASSWORD=your-mailjet-api-secret
MAIL_DEFAULT_SENDER=no-reply@yourdomain.com

RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=1000 per hour; 200 per minute
RATELIMIT_STORAGE_URI=memory://

BLOCK_VPN=true
OTP_VALIDITY_SECONDS=600
