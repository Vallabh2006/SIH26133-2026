{
  "name": "anvaya-vistara",
  "main": "worker.py",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": [
    "python_workers"
  ],
  "routes": [
    {
      "pattern": "app.anvaya.site",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "990c3bce2fca4c00bd70292d799c3727"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "vars": {
    "FLASK_ENV": "production",
    "FLASK_DEBUG": "0",
    "DB_TYPE": "postgres",
    "SESSION_TYPE": "cookie",
    "RATELIMIT_ENABLED": "true",
    "BLOCK_VPN": "false",
    "OTP_VALIDITY_SECONDS": "600"
  }
}